# Plantilla para la futura aplicacion; aun no existe un lector de estas variables.
# Copiar a .env cuando se implemente la configuracion. Nunca versionar valores reales.
TZ=America/Lima
APP_HOST=127.0.0.1
APP_PORT=3000
WEB_PORT=5173

# Primera opcion: login interactivo local de Eve; no copiar tokens a este archivo.
AI_PROVIDER=chatgpt
# MiniMax es alternativo: confirmar antes que los creditos sirven para API.
MINIMAX_API_KEY=

# Datos propuestos para conectar al contenedor existente.
# El puerto publicado debe comprobarse; el usuario de aplicacion aun no esta creado.
SQLSERVER_HOST=127.0.0.1
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=LaPreDigital_Customers
SQLSERVER_USER=lapredigital_app
SQLSERVER_PASSWORD=
SQLSERVER_ENCRYPT=true
# Solo desarrollo local con certificado autofirmado.
SQLSERVER_TRUST_SERVER_CERTIFICATE=true
