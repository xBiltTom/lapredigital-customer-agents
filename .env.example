# Referencia de configuracion local. Compose suministra TZ y AI_PROVIDER al servidor.
# Este archivo no se carga automaticamente; nunca versionar valores reales.
TZ=America/Lima
AI_PROVIDER=chatgpt
# Puerto actual: 127.0.0.1:3000 en el host, 3000 dentro de Docker (compose.yaml).
# Panel React/Vite: 5173. Imagen compilada frontend/API: 3010.
# Tras provisionar la cuenta, aplicar permisos del MVP con scripts/grant-mvp.

# ChatGPT requiere /login interactivo de Eve; no copiar tokens a este archivo.
# MiniMax queda pendiente de confirmar saldo API y autorizacion de uso.

# SQL Docker en Linux: ./scripts/provision-sql-app; Windows: provision-sql-app.ps1.
# Compose declara host-gateway para que este nombre también funcione en Linux.
SQLSERVER_HOST=host.docker.internal
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=LaPreDigital_Customers
SQLSERVER_USER=lapredigital_app
SQLSERVER_PASSWORD=
SQLSERVER_ENCRYPT=true
# Solo para la instancia local con certificado autofirmado.
SQLSERVER_TRUST_SERVER_CERTIFICATE=true

# Identidad local del dueño existente, validada en SQL; no es un contacto del alumno.
# El aprovisionamiento genera un token aleatorio; no copiarlo al frontend ni a Git.
OWNER_PERSONAL_ID=1
OWNER_ACCESS_TOKEN=
