{
  "name": "@lapredigital/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@prisma/adapter-mssql": "7.10.1",
    "@prisma/client": "7.10.1",
    "ai": "7.0.137",
    "eve": "1.0.0-rc.10",
    "mssql": "12.7.14",
    "prisma": "7.10.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/mssql": "12.3.0",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "scripts": {
    "dev": "sh ../../scripts/eve-dev --host 0.0.0.0 --port 3000 --no-ui --no-default-extensions",
    "build": "prisma generate && node scripts/build.mjs",
    "db:check": "node scripts/check-db.mjs",
    "db:t08": "node scripts/check-t08.mjs",
    "db:b01": "node scripts/check-b01.mjs",
    "start": "cd .eve/packaged && eve start --host 0.0.0.0 --port 3000",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate"
  }
}
