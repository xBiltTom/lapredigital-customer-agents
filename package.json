{
  "name": "lapredigital-customer-agents",
  "version": "0.0.0",
  "private": true,
  "description": "Agente Academico de CUSTOMERS para LaPreDigital; proyecto academico local",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "node scripts/check-workspace.mjs",
    "dev:server": "npm run dev --workspace=@lapredigital/server",
    "build:server": "npm run build --workspace=@lapredigital/server",
    "start:server": "npm run start --workspace=@lapredigital/server",
    "typecheck": "npm run typecheck --workspace=@lapredigital/server"
  },
  "packageManager": "npm@11.19.1"
}
