#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
sql_source=$(mktemp)
trap 'rm -f "$sql_source"' EXIT HUP INT TERM
docker compose run --rm --no-deps tools node scripts/import-temario.mjs > "$sql_source"
docker exec -i sql-server-local sh -c 'export SQLCMDPASSWORD="$MSSQL_SA_PASSWORD"; exec /opt/mssql-tools18/bin/sqlcmd -S localhost -U sa -C -b -i /dev/stdin' < "$sql_source"
