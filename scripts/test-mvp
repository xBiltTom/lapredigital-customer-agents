#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
# Solo crea/recrea LaPreDigital_Customers_MvpTest. Nunca cambia el OLTP activo.
source_file=$(mktemp)
trap 'rm -f "$source_file"' EXIT HUP INT TERM
docker compose run --rm --no-deps tools node scripts/test-db-source.mjs > "$source_file"
docker exec -i sql-server-local sh -c 'export SQLCMDPASSWORD="$MSSQL_SA_PASSWORD"; exec /opt/mssql-tools18/bin/sqlcmd -S localhost -U sa -C -b -i /dev/stdin' < "$source_file" > /tmp/lapredigital-mvp-test-setup.log
docker compose run --rm --no-deps --workdir /workspace/apps/server -e SQLSERVER_DATABASE=LaPreDigital_Customers_MvpTest server node scripts/test-mvp.mjs
